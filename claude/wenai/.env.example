# ============================================================
# Wenai · 环境变量清单 (2026-04)
# 本地开发: cp .env.example .env.local 后填值
# Vercel 部署: Dashboard → Project → Settings → Environment Variables
# ============================================================

# -----------------------------------------------------------
# 必填 · AI 模型（同一 key 同时驱动 chat + 生图）
# -----------------------------------------------------------
# 推荐阿里 DashScope: 一个 key 同时解锁 qwen chat + wanx 生图
# 申请: https://dashscope.console.aliyun.com/apiKey
AI_API_KEY=your_dashscope_or_deepseek_key

# chat 模型选择（可选，默认 qwen-plus）
# 选项：qwen-plus / qwen-turbo / qwen-max / deepseek-chat / gpt-4o-mini
AI_MODEL=qwen-plus

# chat API endpoint（可选，默认阿里 DashScope）
# 阿里通义：https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# DeepSeek：https://api.deepseek.com/v1/chat/completions
# OpenAI：https://api.openai.com/v1/chat/completions
AI_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# -----------------------------------------------------------
# 必填 · Auth (生产环境强制，开发留默认会告警)
# -----------------------------------------------------------
# 生成: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_jwt_secret_at_least_32_chars_long
PASSWORD_SALT=your_password_salt_here

# -----------------------------------------------------------
# 可选 · 生图模型配置
# -----------------------------------------------------------
# 通义万相模型（可选，默认 wanx2.1-t2i-turbo）
# 选项: wanx2.1-t2i-turbo (6s/图 省钱) / wanx2.1-t2i-plus (12s/图 质量高)
# WANX_MODEL=wanx2.1-t2i-turbo

# 禁用 wanx 走 mock 模式（调试用，默认 0 启用真生图）
# WANX_DISABLED=0

# 备选生图提供商（未实装，预留）
# FAL_KEY=
# REPLICATE_API_TOKEN=

# -----------------------------------------------------------
# 可选 · 限流与持久化 (Upstash Redis)
# -----------------------------------------------------------
# 申请: https://console.upstash.com
# 不配置则用本地文件+内存 fallback (serverless 冷启动会丢)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------
# 可选 · 内测邀请名册 (覆盖默认内置朋友列表)
# -----------------------------------------------------------
# JSON 格式，key 是邀请码，value 含 name + expiresAt + 可选 tier
# 不配置则使用内置 alice/bob/charlie/demo/wzqfriend
# 示例 (一行):
# INVITE_ROSTER={"alice":{"name":"Alice","expiresAt":"2026-04-30"},"team_xyz":{"name":"XYZ 公司","expiresAt":"2026-12-31","tier":"team"}}
INVITE_ROSTER=

# -----------------------------------------------------------
# 可选 · 外部服务（暂未启用，预留）
# -----------------------------------------------------------
# Stripe（Phase 4 自动化支付，当前走手动二维码）
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Sentry 错误监控
# SENTRY_DSN=

# -----------------------------------------------------------
# -----------------------------------------------------------
# 可选 · OpenAI gpt-image-1 (AI 影棚旗舰模块)
# -----------------------------------------------------------
# AI 影棚 + AI 视频 · HappyHorse / Leone Cloud (唯一主路径)
# -----------------------------------------------------------
# 同款 OpenAI gpt-image-1 模型 + wanx i2v 视频, 国内中转, 一个 key 全开
# 申请联系运营拿 fc_xxx key
# 配了就启用 /pipelines/ai-photoshoot (8 模式) + /pipelines/ai-video (4 场景)
HAPPYHORSE_API_KEY=
HAPPYHORSE_BASE_URL=https://mm-internal-cn.leonecloud.com

# OpenAI 直连已撤掉 (2026-04-27 决策: 一 key 主义)
# 如需恢复双轨, 见 git log commit 911b8f6 之前的版本

# -----------------------------------------------------------
# 可选 · Google Gemini (爆款视频拆解模块)
# -----------------------------------------------------------
# 启用 /pipelines/video-teardown · Gemini 2.5 Flash 拆 TikTok 爆款视频
# 申请: https://aistudio.google.com/apikey (有免费额度)
# 国内服务器走反代: 复制 cloudflare-openai-proxy.js 改 upstream 为
#   https://generativelanguage.googleapis.com 部署后填 GEMINI_BASE_URL
GEMINI_API_KEY=
GEMINI_BASE_URL=

# 说明 · wenai 架构速览
# -----------------------------------------------------------
# 4 条 Pipeline: ai-photoshoot (gpt-image-1) · new-listing · influencer-outbound · product-image (wanx)
# 19 个 Toolbox 模块 (翻译/评论/外联/合规/文案/直播/私域...)
# 详见 README.md 和 .planning/ 目录
