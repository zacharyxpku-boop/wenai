{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .cc24h/hooks/risk-check.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .cc24h/hooks/pre-push-check.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .cc24h/hooks/ui-quality-check.mjs"
          },
          {
            "type": "command",
            "command": "node .cc24h/hooks/auto-screenshot-trigger.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cc24h/hooks/verify-completion.mjs"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cc24h/hooks/postcompact-inject.mjs"
          }
        ]
      }
    ]
  }
}
